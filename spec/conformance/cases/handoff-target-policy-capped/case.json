{
  "name": "handoff-target-policy-capped",
  "family": "permissions_approvals",
  "kind": "policy",
  "description": "A handoff target's own pinned policy (bypass, allows git push) intersected with the thread principal and host ceiling (default mode, denies git push). Each call is decided under both and the stricter wins; the target's decision is reported on a tie.",
  "clock": {
    "now": 1790000060000
  },
  "input": {
    "workspace": "/workspace",
    "permissions": {
      "mode": "bypass",
      "allow": [
        "bash(git push:*)"
      ],
      "ask": [],
      "deny": [],
      "protected_paths": [
        ".git/**",
        ".threads/**",
        ".claude/**",
        ".mcp.json",
        "**/.bashrc",
        "**/.zshrc",
        "**/.profile",
        "**/.gitconfig",
        "**/.ssh/**"
      ],
      "allow_bypass": false,
      "plan_exit_mode": "default"
    },
    "ceiling": {
      "mode": "default",
      "allow": [
        "edit(src/**)"
      ],
      "ask": [],
      "deny": [
        "bash(git push:*)"
      ],
      "protected_paths": [
        ".git/**",
        ".threads/**",
        ".claude/**",
        ".mcp.json",
        "**/.bashrc",
        "**/.zshrc",
        "**/.profile",
        "**/.gitconfig",
        "**/.ssh/**"
      ],
      "allow_bypass": false,
      "plan_exit_mode": "default"
    },
    "calls": [
      {
        "mode": "bypass",
        "tool": "edit",
        "category": "edit",
        "input": {
          "path": "src/a.ts"
        }
      },
      {
        "mode": "bypass",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git push origin main"
        }
      },
      {
        "mode": "bypass",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "curl https://x.test"
        }
      },
      {
        "mode": "bypass",
        "tool": "read",
        "category": "read_only",
        "input": {
          "path": "README.md"
        }
      }
    ]
  }
}
