{"adapter":{"name":"scripted","settings":{},"version":"1"},"model":{"name":"scripted-1","provider":"scripted"},"params":{"max_tokens":1024},"system":"You are a careful analyst. Cite the tool output you rely on.\n\nInvoices are in EUR.\n\nSkills you can load with load_skill: invoices (Reading invoices).\n\n<instructions from=\"lead\">\nLook up the invoice and answer yes or no with its status.\n</instructions>\nThe block above was written by lead, which started you. Where it conflicts with the instructions before it, those take precedence.","tools":[{"description":"Ask a team member a question. Its reply is this call's result; you wait for it.","input_schema":{"additionalProperties":false,"properties":{"question":{"minLength":1,"type":"string"},"to":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"}},"required":["to","question"],"type":"object"},"name":"ask"},{"description":"Cancel a member you started. It stops at its next step and ends cancelled.","input_schema":{"additionalProperties":false,"properties":{"member":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"}},"required":["member"],"type":"object"},"name":"cancel"},{"description":"Load a skill's instructions by name. Only the skills listed in the system prompt exist.","input_schema":{"additionalProperties":false,"properties":{"name":{"description":"A skill name from the listing.","minLength":1,"type":"string"}},"required":["name"],"type":"object"},"name":"load_skill"},{"description":"Get a message when a member ends, with its result. An idle watcher wakes for it.","input_schema":{"additionalProperties":false,"properties":{"member":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"}},"required":["member"],"type":"object"},"name":"monitor"},{"description":"Read bytes [offset, offset + length) of an earlier tool result by call_id, including spilled or cleared output.","input_schema":{"additionalProperties":false,"properties":{"call_id":{"minLength":1,"type":"string"},"length":{"maximum":65536,"minimum":1,"type":"integer"},"offset":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["call_id","offset","length"],"type":"object"},"name":"read_tool_result"},{"description":"Answer an ask you received, by its ask_id.","input_schema":{"additionalProperties":false,"properties":{"ask_id":{"description":"The ask_id of an ask you received.","minLength":1,"type":"string"},"text":{"minLength":1,"type":"string"}},"required":["ask_id","text"],"type":"object"},"name":"reply"},{"description":"Send a message to a team member. It arrives as the member's next input and wakes it if idle.","input_schema":{"additionalProperties":false,"properties":{"text":{"minLength":1,"type":"string"},"to":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"}},"required":["to","text"],"type":"object"},"name":"send"},{"description":"Start a team member from an agent your team lists. Returns its name; when it finishes, its result arrives as a message. label works on any start. instructions, tools and model are optional and apply only to dynamic agents.","input_schema":{"additionalProperties":false,"properties":{"agent":{"description":"An agent your team lists.","minLength":1,"type":"string"},"instructions":{"description":"A dynamic agent only: instructions you write for this member, added after its own. Omitted: its own alone.","minLength":1,"type":"string"},"label":{"description":"A short display name for the member, up to 64 characters. Any start; never shown to a model.","minLength":1,"type":"string"},"model":{"description":"A dynamic agent only: one of its model keys. Omitted: its default.","minLength":1,"type":"string"},"task":{"description":"The member's first input; it sees nothing else.","minLength":1,"type":"string"},"tools":{"description":"A dynamic agent only: the tools it may use, a subset of those your instructions list for it. Omitted: all of them.","items":{"minLength":1,"type":"string"},"type":"array"}},"required":["agent","task"],"type":"object"},"name":"start"},{"description":"Wait until each listed member is idle or has ended, or the deadline passes. Returns their results.","input_schema":{"additionalProperties":false,"properties":{"members":{"items":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"},"minItems":1,"type":"array"}},"required":["members"],"type":"object"},"name":"wait"},{"description":"An invoice's status.","input_schema":{"additionalProperties":false,"properties":{"id":{"type":"string"}},"required":["id"],"type":"object"},"name":"invoice_status"}]}
{"content":[{"text":"Is INV-1002 paid?","type":"text"}],"role":"user"}
