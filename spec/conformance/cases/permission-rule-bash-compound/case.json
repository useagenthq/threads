{
  "name": "permission-rule-bash-compound",
  "family": "permissions_approvals",
  "kind": "policy",
  "description": "A command joined with &&, ||, ;, |, & or a newline is allowed only when every simple command matches an allow rule; the first command's rule is reported. One unmatched part asks, one part matching an ask rule asks, and one part matching a deny rule denies the whole command. A redirection, expansion or unclosed quote anywhere asks.",
  "clock": {
    "now": 1790000060000
  },
  "input": {
    "workspace": "/workspace",
    "permissions": {
      "mode": "default",
      "allow": [
        "bash(git status:*)",
        "bash(npm test)"
      ],
      "ask": [
        "bash(git push:*)"
      ],
      "deny": [
        "bash(rm:*)"
      ],
      "protected_paths": [
        ".git/**",
        ".threads/**",
        ".claude/**",
        ".mcp.json",
        "**/.bashrc",
        "**/.zshrc",
        "**/.profile",
        "**/.gitconfig",
        "**/.ssh/**"
      ],
      "allow_bypass": false,
      "plan_exit_mode": "default"
    },
    "calls": [
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && npm test"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status | npm test"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "npm test; git status -s"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "npm test || git status"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "npm test & git status"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "npm test\ngit status"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && FOO=1 npm test"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && ls"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && PATH=/x npm test"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && rm -rf build"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "npm test | git push origin"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git push origin; rm -rf build"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && echo $(id)"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status > out.txt && npm test"
        }
      },
      {
        "mode": "default",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && npm test 'unclosed"
        }
      },
      {
        "mode": "dont_ask",
        "tool": "bash",
        "category": "other",
        "input": {
          "command": "git status && ls"
        }
      }
    ]
  }
}
