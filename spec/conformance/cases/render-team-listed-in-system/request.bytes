{"adapter":{"name":"scripted","settings":{},"version":"1"},"model":{"name":"scripted-1","provider":"scripted"},"params":{"max_tokens":1024},"system":"You lead a research team.\n\nAgents you can start as team members with start: researcher, writer.","tools":[{"description":"Read bytes [offset, offset + length) of an earlier tool result by call_id, including spilled or cleared output.","input_schema":{"additionalProperties":false,"properties":{"call_id":{"minLength":1,"type":"string"},"length":{"maximum":65536,"minimum":1,"type":"integer"},"offset":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["call_id","offset","length"],"type":"object"},"name":"read_tool_result"},{"description":"Send a message to a team member. It arrives as the member's next input and wakes it if idle.","input_schema":{"additionalProperties":false,"properties":{"text":{"minLength":1,"type":"string"},"to":{"description":"A member's name, such as researcher-1.","minLength":1,"type":"string"}},"required":["to","text"],"type":"object"},"name":"send"},{"description":"Start a team member from an agent your team lists. Returns its name; when it finishes, its result arrives as a message. label works on any start. instructions, tools and model are optional and apply only to dynamic agents.","input_schema":{"additionalProperties":false,"properties":{"agent":{"description":"An agent your team lists.","minLength":1,"type":"string"},"instructions":{"description":"A dynamic agent only: instructions you write for this member, added after its own. Omitted: its own alone.","minLength":1,"type":"string"},"label":{"description":"A short display name for the member, up to 64 characters. Any start; never shown to a model.","minLength":1,"type":"string"},"model":{"description":"A dynamic agent only: one of its model keys. Omitted: its default.","minLength":1,"type":"string"},"task":{"description":"The member's first input; it sees nothing else.","minLength":1,"type":"string"},"tools":{"description":"A dynamic agent only: the tools it may use, a subset of those your instructions list for it. Omitted: all of them.","items":{"minLength":1,"type":"string"},"type":"array"}},"required":["agent","task"],"type":"object"},"name":"start"},{"description":"Replace your todo list with todos, the complete new list. Use it to plan and track multi-step work.","input_schema":{"additionalProperties":false,"properties":{"todos":{"description":"The complete new list; ids are unique.","items":{"additionalProperties":false,"properties":{"active_form":{"description":"Present tense, shown while in_progress.","type":"string"},"content":{"minLength":1,"type":"string"},"id":{"minLength":1,"type":"string"},"status":{"enum":["pending","in_progress","completed"],"type":"string"}},"required":["id","content","status"],"type":"object"},"type":"array"}},"required":["todos"],"type":"object"},"name":"todo_write"}]}
{"content":[{"text":"Report on batteries.","type":"text"}],"role":"user"}
