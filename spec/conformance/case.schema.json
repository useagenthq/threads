{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:threads:schema:conformance:v1",
  "title": "threads conformance fixture files",
  "description": "Schemas for case.json, expected.json, model.json, sandbox.json and stubs.json. Event shapes come from ../schema/events.v1.schema.json.",
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "family",
        "kind",
        "description",
        "clock"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "family": {
          "enum": [
            "tools_streaming",
            "context_compaction",
            "memory",
            "skills",
            "permissions_approvals",
            "hooks",
            "agents_teams",
            "tasks",
            "cancellation_resume",
            "scheduling",
            "sandboxes",
            "channels",
            "log_fork_test",
            "knowledge",
            "log"
          ]
        },
        "kind": {
          "enum": [
            "reduce",
            "render",
            "recover",
            "fork",
            "stub",
            "intake",
            "host",
            "security",
            "parity",
            "policy"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "description": "The injected clock. Runners never read wall time.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "now"
          ],
          "properties": {
            "now": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "model_script": {
          "const": "model.json"
        },
        "sandbox_script": {
          "const": "sandbox.json"
        },
        "input": {
          "description": "Kind-specific operation input.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fork_at_event_id": {
              "type": "string"
            },
            "new_branch_id": {
              "type": "string"
            },
            "knowledge_policy": {
              "description": "fork: the child's corpus policy. Absent means the API default, pinned.",
              "enum": [
                "pinned",
                "current"
              ]
            },
            "webhooks": {
              "description": "intake: webhooks delivered in order; a repeated delivery simulates provider redelivery.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Webhook"
              }
            },
            "workspace": {
              "description": "policy: the sandbox workspace root that relative path rules resolve against.",
              "type": "string"
            },
            "permissions": {
              "description": "policy: the rule set.",
              "$ref": "urn:threads:schema:events:v1#/$defs/Policy/properties/permissions"
            },
            "calls": {
              "description": "policy: calls to decide, each under its own mode.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/PolicyCall"
              }
            },
            "ceiling": {
              "description": "policy: the principal/host ceiling a handoff target is intersected with. Each call is decided under both; the stricter decision wins (deny > ask > allow), the target's on a tie.",
              "$ref": "urn:threads:schema:events:v1#/$defs/Policy/properties/permissions"
            },
            "text": {
              "description": "stub: the user_input the runner sends once the log is imported (a saved case's next input after its snapshot). saveCase always writes it.",
              "type": "string"
            },
            "requests": {
              "description": "host: POST /v1/runs requests in order, each as its authenticated principal.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/HostRequest"
              }
            }
          }
        },
        "stub_script": {
          "const": "stubs.json"
        },
        "expect": {
          "description": "stub, written by saveCase: the case's assertion over the events the run appends. Each `must` matcher matches at least one appended event, else the case fails; `expect` matchers are only reported.",
          "$ref": "#/$defs/CaseExpectation"
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "$ref": "urn:threads:schema:events:v1#/$defs/ErrorCode"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "state": {
          "$ref": "#/$defs/ReducedState"
        },
        "committed_bytes": {
          "description": "Length of the prefix readers serve.",
          "type": "integer",
          "minimum": 0
        },
        "appended": {
          "description": "Exactly the events the runner must append, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventMatcher"
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dispatches": {
              "$ref": "#/$defs/Counts"
            },
            "new_executions": {
              "$ref": "#/$defs/Counts"
            },
            "lookups": {
              "$ref": "#/$defs/Counts"
            }
          }
        },
        "fork": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "child_created": {
              "type": "boolean"
            },
            "at_seq": {
              "type": "integer",
              "minimum": 1
            },
            "parent_unchanged": {
              "const": true
            },
            "knowledge_revision": {
              "description": "The knowledge revision the child searches as of: the snapshot's knowledge_revision under pinned, null under current.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "child_state": {
              "description": "The child branch's stored state after the operation (and, for restore_response: crash, after recovery).",
              "enum": [
                "forking",
                "ready",
                "inspection_only",
                "read_only",
                "corrupt",
                "fork_failed"
              ]
            }
          }
        },
        "resources": {
          "description": "fork: the provider create calls the fake sandbox saw, and the resource-ledger rows the operation left.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "creates",
            "rows"
          ],
          "properties": {
            "creates": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "state"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "sandbox",
                      "snapshot",
                      "retention_hold"
                    ]
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "live",
                      "releasing",
                      "released",
                      "release_failed",
                      "unknown"
                    ]
                  }
                }
              }
            }
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "next_request_sha256",
            "declared_prefix"
          ],
          "properties": {
            "next_request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "declared_prefix": {
              "description": "Render v1 line 0 of the next request. Every recorded model_request's declared_prefix equals the line 0 of its own settings epoch (C7), so it equals this only when no settings_changed lies between them.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bytes",
                "sha256"
              ],
              "properties": {
                "bytes": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "head_verified": {
          "description": "false when the input has no valid head checkpoint (torn or truncated export). Absent means true.",
          "type": "boolean"
        },
        "stubs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumed",
            "unmatched"
          ],
          "properties": {
            "consumed": {
              "type": "integer",
              "minimum": 0
            },
            "unmatched": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "responses": {
          "description": "intake: HTTP status returned for each webhook, in order.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "inbox": {
          "description": "intake: inbox rows after all webhooks, in insertion order.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "item_key"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "item_key": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "description": "policy: one decision per input call, in order.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "source"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              "source": {
                "enum": [
                  "policy",
                  "mode",
                  "protected_path",
                  "self_config_guard",
                  "thread_rule"
                ]
              },
              "rule": {
                "type": "string"
              }
            }
          }
        },
        "projections": {
          "description": "Named projections beyond ReducedState, compared by deep equality only for the keys listed (ADRs 0019-0023).",
          "$ref": "#/$defs/Projections"
        },
        "threads": {
          "description": "intake: distinct threads the inbox rows map to.",
          "type": "integer",
          "minimum": 0
        },
        "api": {
          "description": "host: one answer per request, in order. receipt is the index of the request whose 202 receipt this one equals (its own index for a new run); code is the error code of a non-2xx answer.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "integer"
              },
              "receipt": {
                "type": "integer",
                "minimum": 0
              },
              "code": {
                "type": "string"
              }
            }
          }
        },
        "user_inputs": {
          "description": "host: user_input events in the logs of every thread a receipt names.",
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "Counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "EventMatcher": {
      "description": "Matches one appended event. data is a deep subset: objects match by listed keys, arrays and scalars match exactly. event_id, time and prev_hash are never compared; the chain and head are checked separately.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "actor_kind": {
          "type": "string"
        },
        "epoch": {
          "type": "integer"
        },
        "branch_id": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "CaseExpectation": {
      "description": "spec/api.json CaseExpectation as JSON Schema (check_api.py keeps the two equal).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must"
      ],
      "properties": {
        "must": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EventMatcher"
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventMatcher"
          }
        }
      }
    },
    "ReducedState": {
      "description": "The normative v1 projection used for cross-language comparison. Compared by deep equality.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_id",
        "branch_id",
        "head",
        "epoch",
        "status",
        "turns_completed",
        "pending_calls",
        "effects",
        "parked",
        "fork_points",
        "usage",
        "transcript"
      ],
      "properties": {
        "thread_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "hash"
          ],
          "properties": {
            "seq": {
              "type": "integer"
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "epoch": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "idle",
            "in_turn",
            "parked",
            "cancelled",
            "inspection_only"
          ]
        },
        "turns_completed": {
          "type": "integer"
        },
        "pending_calls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect_key",
              "call_id",
              "status"
            ],
            "properties": {
              "effect_key": {
                "type": "string",
                "description": "Derived: <branch_id of the tool_call event>:<call_id>."
              },
              "call_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "begun",
                  "committed",
                  "unknown",
                  "resolved"
                ]
              }
            }
          }
        },
        "parked": {
          "type": "array",
          "items": {
            "$ref": "urn:threads:schema:events:v1#/$defs/ParkAddress"
          }
        },
        "fork_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "snapshot_event_id"
            ],
            "properties": {
              "seq": {
                "type": "integer"
              },
              "snapshot_event_id": {
                "type": "string"
              }
            }
          }
        },
        "usage": {
          "description": "Sums of KNOWN input_tokens and output_tokens over model responses; unknown_responses counts responses where either is null. Unknown is never summed as zero.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "unknown_responses"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            },
            "unknown_responses": {
              "type": "integer"
            }
          }
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "event_id"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "context",
                  "assistant",
                  "tool",
                  "summary"
                ]
              },
              "event_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ModelScript": {
      "description": "Entries consumed in order: a response, or a provider error the adapter reports before any content. An extra model call, or leftover entries at the end, fails the case. lookup answers adapter response recovery per model_request event_id.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses"
      ],
      "properties": {
        "responses": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content",
                  "stop_reason",
                  "usage"
                ],
                "properties": {
                  "content": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:threads:schema:events:v1#/$defs/OutputPart"
                    }
                  },
                  "stop_reason": {
                    "type": "string"
                  },
                  "usage": {
                    "$ref": "urn:threads:schema:events:v1#/$defs/Usage"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "error"
                ],
                "properties": {
                  "error": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reason",
                      "http_status"
                    ],
                    "properties": {
                      "reason": {
                        "enum": [
                          "rate_limited",
                          "overloaded",
                          "server_error",
                          "prompt_too_long"
                        ]
                      },
                      "http_status": {
                        "type": "integer"
                      },
                      "retry_after_ms": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "lookup": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "final"
            ],
            "properties": {
              "result": {
                "enum": [
                  "found",
                  "not_found"
                ]
              },
              "final": {
                "type": "boolean"
              },
              "provider_request_id": {
                "type": "string"
              },
              "response": {
                "$ref": "#/$defs/ModelScript/properties/responses/items/oneOf/0"
              }
            }
          }
        }
      }
    },
    "SandboxScript": {
      "description": "A fake sandbox/provider. A dispatch whose effect key is in executed_keys returns that output with no new execution (provider dedup); any other dispatch is a new execution returning output. lookup answers reconciliation; process answers termination checks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output"
            ],
            "properties": {
              "output": {
                "type": "string"
              },
              "is_error": {
                "type": "boolean"
              },
              "executed_keys": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "lookup": {
                "description": "Adapter lookup answers per derived effect key. final says whether the adapter contract makes the answer final.",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result",
                    "final"
                  ],
                  "properties": {
                    "result": {
                      "enum": [
                        "found",
                        "not_found"
                      ]
                    },
                    "final": {
                      "type": "boolean"
                    },
                    "output": {
                      "type": "string"
                    }
                  }
                }
              },
              "process": {
                "description": "What the sandbox reports about the call's process group during recovery.",
                "enum": [
                  "running",
                  "terminated",
                  "unknown"
                ]
              }
            }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "restore_sandbox_id",
              "manifest"
            ],
            "properties": {
              "restore_sandbox_id": {
                "type": "string"
              },
              "restore_response": {
                "description": "ok (default): the restore create returns normally. lost: the provider creates the sandbox but the response never arrives. crash: the restore succeeds, then the host dies before the child's fork event is appended; the runner restarts and runs recovery.",
                "enum": [
                  "ok",
                  "lost",
                  "crash"
                ]
              },
              "create_lookup": {
                "description": "What the adapter can do with the operation_key after a lost response: found (lookup finds the resource) or unsupported (no idempotent create and no lookup).",
                "enum": [
                  "found",
                  "unsupported"
                ]
              },
              "manifest": {
                "description": "The captured file tree: one entry per file, sorted by path. The snapshot event's manifest_hash is its canonical hash (Domain A); restore verifies the restored tree against it (snapshot_manifest_mismatch otherwise).",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "mode",
                    "size",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "installation_id",
        "delivery_id",
        "items"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "installation_id": {
          "type": "string"
        },
        "delivery_id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversation",
              "sender",
              "text"
            ],
            "properties": {
              "item_id": {
                "type": "string"
              },
              "conversation": {
                "type": "string"
              },
              "sender": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "forged": {
          "description": "intake: the fake adapter's verify refuses this delivery (a bad signature or a replay).",
          "type": "boolean"
        }
      }
    },
    "StubScript": {
      "description": "Recorded stubs for stub mode. Matched on (tool, args_hash, occurrence) and consumed in order; an invocation with no unconsumed match fails with unmatched_external_op.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stubs"
      ],
      "properties": {
        "stubs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "args_hash",
              "occurrence",
              "output"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "args_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "occurrence": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "string"
              },
              "is_error": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "PolicyCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tool",
        "category",
        "input"
      ],
      "properties": {
        "mode": {
          "$ref": "urn:threads:schema:events:v1#/$defs/PermissionMode"
        },
        "tool": {
          "type": "string"
        },
        "category": {
          "description": "read_only, edit (write, edit, apply_patch, notebook_edit inside the workspace) or other (mode table).",
          "enum": [
            "read_only",
            "edit",
            "other"
          ]
        },
        "input": {
          "type": "object"
        }
      }
    },
    "Projections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "child_thread_id",
              "status"
            ],
            "properties": {
              "child_thread_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "running",
                  "completed",
                  "failed",
                  "cancelled",
                  "budget_exhausted"
                ]
              }
            }
          }
        },
        "team_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "status"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "claimed",
                  "completed",
                  "failed"
                ]
              },
              "owner": {
                "type": "string"
              }
            }
          }
        },
        "mode": {
          "$ref": "urn:threads:schema:events:v1#/$defs/PermissionMode"
        },
        "model": {
          "$ref": "urn:threads:schema:events:v1#/$defs/ModelRef"
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "known_nanos",
            "upper_bound_nanos",
            "complete",
            "bounded"
          ],
          "properties": {
            "currency": {
              "type": "string"
            },
            "known_nanos": {
              "type": "integer"
            },
            "upper_bound_nanos": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            },
            "bounded": {
              "type": "boolean",
              "description": "false when some unknown usage has no declared bound; upper_bound_nanos is then not a bound."
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "none",
                "accepted",
                "rejected"
              ]
            },
            "value": {}
          }
        },
        "cache_breaks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_event_id",
              "likely_cause"
            ],
            "properties": {
              "request_event_id": {
                "type": "string"
              },
              "likely_cause": {
                "enum": [
                  "settings_changed",
                  "compacted",
                  "context_edited",
                  "tools_changed",
                  "ttl_expired",
                  "unknown"
                ]
              }
            }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutive_failures",
            "breaker_open"
          ],
          "properties": {
            "consecutive_failures": {
              "type": "integer"
            },
            "breaker_open": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "HostRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "idempotency_key",
        "body"
      ],
      "properties": {
        "principal": {
          "$ref": "urn:threads:schema:events:v1#/$defs/Principal"
        },
        "idempotency_key": {
          "description": "The Idempotency-Key header (1 to 255 characters).",
          "type": "string",
          "minLength": 1
        },
        "body": {
          "description": "The POST /v1/runs body as sent: a host-api StartRunRequest (urn:threads:schema:host-api:v1#/$defs/StartRunRequest).",
          "type": "object"
        }
      }
    }
  }
}
