{
  "vectors": [
    {
      "name": "a message with done false",
      "output": {
        "message": "Then the repair, please.",
        "done": false
      },
      "expect": "accept"
    },
    {
      "name": "done true with an empty message",
      "output": {
        "message": "",
        "done": true
      },
      "expect": "accept"
    },
    {
      "name": "done true still carries its message",
      "output": {
        "message": "Thanks.",
        "done": true
      },
      "expect": "accept"
    },
    {
      "name": "an empty message with done false",
      "output": {
        "message": "",
        "done": false
      },
      "expect": "simulator_invalid"
    },
    {
      "name": "a message over 4,000 characters",
      "output": {
        "message": "",
        "done": false
      },
      "expect": "simulator_invalid"
    },
    {
      "name": "a missing done",
      "output": {
        "message": "Hello."
      },
      "expect": "simulator_invalid"
    },
    {
      "name": "an extra field",
      "output": {
        "message": "Hi.",
        "done": false,
        "mood": "cross"
      },
      "expect": "simulator_invalid"
    },
    {
      "name": "done that is not a boolean",
      "output": {
        "message": "Hi.",
        "done": "yes"
      },
      "expect": "simulator_invalid"
    },
    {
      "name": "not an object",
      "output": "Then the repair.",
      "expect": "simulator_invalid"
    }
  ]
}
