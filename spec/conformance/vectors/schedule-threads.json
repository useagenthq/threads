{
  "description": "One thread per schedule. Each case replays its steps on one store, with a schedule and a scripted agent 'bot' that answers every run. Steps: start (a new scheduler, named by the value, ready at 'at'; optional tenant, default local; optional schedules, default [schedule]; optional agents served, default ['bot'], each named by its key; optional instructions for those agents, default none); tick (one pass of that scheduler at 'at', then its runs settle); race (the named schedulers tick at 'at' at once, then settle); hold (an outside holder takes the local schedule thread's writer: 'run' also appends a user_input and leaves the turn open, 'outbound' only holds the lease); release ('done': the holder lets go and a held run finishes its turn; 'crash': the lease is let go and the turn is left open); delete (the local schedule thread is deleted); expect (per tenant: log is the schedule thread's schedule_fired and schedule_skipped events in order as 'fired <occurrence_id>' or 'skipped <reason> <occurrence_id>', empty when the schedule has no thread; rows are the tenant's schedule_occurrences as [occurrence_at as RFC 3339 UTC with milliseconds, state, reason] in occurrence order; threads, when given, is the tenant's thread count; inputs, when given, are the texts of the schedule thread's user_inputs whose source is schedule; one_hold, when given, are log entries whose events share one epoch, so one writer hold appended them all).",
  "schedule": {
    "id": "daily",
    "agent": "bot",
    "cron": "0 9 * * *",
    "input": "Report."
  },
  "cases": [
    {
      "name": "schedule-fires-once",
      "note": "Ready triggers nothing; the due occurrence fires once, with schedule_fired then its input.",
      "steps": [
        {
          "start": "a",
          "at": "2026-05-01T08:59:00Z"
        },
        {
          "tick": "a",
          "at": "2026-05-01T08:59:30Z"
        },
        {
          "expect": {
            "local": {
              "log": [],
              "rows": [],
              "threads": 0
            }
          }
        },
        {
          "tick": "a",
          "at": "2026-05-01T09:00:01Z"
        },
        {
          "tick": "a",
          "at": "2026-05-01T09:00:02Z"
        },
        {
          "expect": {
            "local": {
              "log": [
                "fired daily@2026-05-01T09:00:00.000Z"
              ],
              "rows": [
                [
                  "2026-05-01T09:00:00.000Z",
                  "fired",
                  null
                ]
              ],
              "threads": 1,
              "inputs": [
                "Report."
              ]
            }
          }
        }
      ]
    },
