{
  "description": "Schedule occurrences across DST transitions. A nonexistent local time (spring forward) runs once, at the first valid instant after it; an ambiguous local time (fall back) runs once, at its first instance. Each case lists every occurrence instant (UTC) in (from, to].",
  "cases": [
    {
      "name": "schedule-dst-nonexistent",
      "cron": "30 2 * * *",
      "timezone": "America/New_York",
      "from": "2026-03-08T00:00:00Z",
      "to": "2026-03-09T00:00:00Z",
      "occurrences": ["2026-03-08T07:00:00Z"]
    },
    {
      "name": "schedule-dst-ambiguous",
      "cron": "30 1 * * *",
      "timezone": "America/New_York",
      "from": "2026-11-01T00:00:00Z",
      "to": "2026-11-02T00:00:00Z",
      "occurrences": ["2026-11-01T05:30:00Z"]
    },
    {
      "name": "schedule-dst-nonexistent-europe",
      "cron": "15 2 * * *",
      "timezone": "Europe/Berlin",
      "from": "2026-03-29T00:00:00Z",
      "to": "2026-03-30T00:00:00Z",
      "occurrences": ["2026-03-29T01:00:00Z"]
    },
    {
      "name": "schedule-dst-ambiguous-europe",
      "cron": "15 2 * * *",
      "timezone": "Europe/Berlin",
      "from": "2026-10-25T00:00:00Z",
      "to": "2026-10-26T00:00:00Z",
      "occurrences": ["2026-10-25T00:15:00Z"]
    },
    {
      "name": "schedule-dst-repeat-after-range-start",
      "note": "The first 01:00 (05:00Z) is outside (from, to]; its repeat at 06:00Z (01:00 EST) still must not fire. A scan must not rely on having seen the first instance.",
      "cron": "*/30 1 * * *",
      "timezone": "America/New_York",
      "from": "2026-11-01T05:00:00Z",
      "to": "2026-11-01T07:00:00Z",
      "occurrences": ["2026-11-01T05:30:00Z"]
    }
  ]
}
