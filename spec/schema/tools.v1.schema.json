{
  "$defs": {
    "BashInput": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Run with bash -c.",
          "minLength": 1,
          "type": "string"
        },
        "timeout_ms": {
          "description": "Default 120000.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "EditInput": {
      "additionalProperties": false,
      "properties": {
        "expected_sha256": {
          "description": "The file's current lowercase hex sha256; a mismatch changes nothing.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "new_string": {
          "type": "string"
        },
        "old_string": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "description": "Relative to /workspace, or absolute.",
          "minLength": 1,
          "type": "string"
        },
        "replace_all": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "old_string",
        "new_string"
      ],
      "type": "object"
    },
    "ForgetMemoryInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The id of a recalled memory.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "GlobInput": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "default": ".",
          "description": "Directory, relative to /workspace; . is the workspace root.",
          "minLength": 1,
          "type": "string"
        },
        "pattern": {
          "description": "A gitignore-style glob relative to path; ** spans directories.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    },
    "GrepInput": {
      "additionalProperties": false,
      "properties": {
        "glob": {
          "description": "Only files whose path relative to path matches this glob.",
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "default": ".",
          "description": "Directory, relative to /workspace; . is the workspace root.",
          "minLength": 1,
          "type": "string"
        },
        "pattern": {
          "description": "An extended regular expression.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    },
    "HandoffInput": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "A handoff target listed in your instructions.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "LsInput": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "default": ".",
          "description": "Directory, relative to /workspace; . is the workspace root.",
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "ReadInput": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 2000,
          "description": "Lines to read.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 1,
          "description": "First line, 1-based.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "Relative to /workspace, or absolute.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ReadToolResultInput": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "minLength": 1,
          "type": "string"
        },
        "length": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "call_id",
        "offset",
        "length"
      ],
      "type": "object"
    },
    "SaveMemoryInput": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "The fact to remember, self-contained.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SearchKnowledgeInput": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "description": "Most hits to return. Default 5.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "description": "Only these source ids.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "SearchMemoryInput": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "description": "Most hits to return. Default 5.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "SendMessageInput": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "description": "A member's agent name, or * for every member.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "to",
        "text"
      ],
      "type": "object"
    },
    "SpawnAgentInput": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "A subagent name listed in your instructions.",
          "minLength": 1,
          "type": "string"
        },
        "background": {
          "description": "Default false: wait for the result.",
          "type": "boolean"
        },
        "isolation": {
          "description": "Default none.",
          "enum": [
            "none",
            "shared_sandbox",
            "worktree",
            "forked_sandbox"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "The task; the subagent sees nothing else.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "agent",
        "prompt"
      ],
      "type": "object"
    },
    "TeamTaskClaimInput": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    },
    "TeamTaskCreateInput": {
      "additionalProperties": false,
      "properties": {
        "blocked_by": {
          "description": "Task ids that must complete before this one can be claimed.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject"
      ],
      "type": "object"
    },
    "TeamTaskUpdateInput": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "description": "released returns a claimed task to the open pool.",
          "enum": [
            "completed",
            "failed",
            "released"
          ],
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "status"
      ],
      "type": "object"
    },
    "TodoWriteInput": {
      "additionalProperties": false,
      "properties": {
        "todos": {
          "description": "The complete new list; ids are unique.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "active_form": {
                "description": "Present tense, shown while in_progress.",
                "type": "string"
              },
              "content": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "content",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "todos"
      ],
      "type": "object"
    },
    "WriteInput": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "expected_sha256": {
          "description": "The file's current lowercase hex sha256; a mismatch changes nothing.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "path": {
          "description": "Relative to /workspace, or absolute.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "type": "object"
    }
  },
  "$id": "urn:threads:schema:tools:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Generated from typescript/packages/core/src/tools/catalog.ts by bun run schema:export. Do not edit.",
  "title": "Built-in tool inputs"
}
