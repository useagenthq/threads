{
  // Compiles generated/surface.ts (spec/tools/gen_api_surface.py) against the public entries.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    // The MCP SDK's own .d.ts doesn't compile under exactOptionalPropertyTypes; our code does.
    "skipLibCheck": true,
    "noEmit": true,
    // Core depends on no other package, so every entry (host, mcp, the adapter packages whose
    // factories are in the contract) is mapped to its source here.
    "paths": {
      "@threads/core": ["../../src/index.ts"],
      "@threads/*": ["../../../*/src/index.ts"]
    }
  },
  "include": ["generated/surface.ts"]
}
