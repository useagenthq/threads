{
  "name": "threads-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen": "python3 scripts/gen_api_ref.py && bun scripts/gen-openapi.ts",
    "check:gen": "python3 scripts/gen_api_ref.py --check && bun scripts/gen-openapi.ts --check",
    "check:links": "bun scripts/check-links.ts",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-openapi": "^12.0.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.13",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.14"
  }
}
